    {
      "name": "02_Auth",
      "item": [
        {
          "name": "TC07 - GET /notifications/recent - valid token is accepted",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/notifications/recent?limit=1",
              "host": ["{{baseUrl}}"],
              "path": ["notifications", "recent"],
              "query": [
                { "key": "limit", "value": "1" }
              ]
            },
            "description": "Kiểm tra request có Bearer token hợp lệ được chấp nhận."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Valid token request returns 200', function () {",
                  "  pm.expect(pm.response.code).to.eql(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC08 - POST /notifications - missing token is rejected with 401",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/notifications",
              "host": ["{{baseUrl}}"],
              "path": ["notifications"]
            },
            "description": "Auth test thật: gửi request không có header Authorization (không dùng Prefer: code=401). Prism và service thật đều từ chối với 401.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"123e4567-e89b-12d3-a456-426614174000\",\n  \"event_name\": \"alert.created\",\n  \"correlationId\": \"req-0196fb3d-4ad7-7d1e-9f49-5d5148d2babc\",\n  \"source\": \"core-business\",\n  \"alert_id\": \"ALT-001\",\n  \"severity\": \"high\",\n  \"message\": \"Phát hiện sự cố an ninh khẩn cấp từ Core Business\",\n  \"target_channels\": [\"telegram\"],\n  \"timestamp\": \"2026-08-27T15:30:00Z\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Missing token returns 401 or 403', function () {",
                  "  pm.expect([401, 403]).to.include(pm.response.code);",
                  "});",
                  "pm.test('Unauthorized response follows ProblemDetails', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('status');",
                  "  pm.expect(json.status).to.be.within(400, 499);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC09 - POST /notifications - invalid token is rejected on real service",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer invalid-token" }
            ],
            "url": {
              "raw": "{{baseUrl}}/notifications",
              "host": ["{{baseUrl}}"],
              "path": ["notifications"]
            },
            "description": "Auth test với token không hợp lệ: service local từ chối với 401/403; trên mock được ghi chú rõ vì Prism chỉ kiểm tra sự tồn tại của Bearer header.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"123e4567-e89b-12d3-a456-426614174000\",\n  \"event_name\": \"alert.created\",\n  \"correlationId\": \"req-0196fb3d-4ad7-7d1e-9f49-5d5148d2babc\",\n  \"source\": \"core-business\",\n  \"alert_id\": \"ALT-001\",\n  \"severity\": \"high\",\n  \"message\": \"Phát hiện sự cố an ninh khẩn cấp từ Core Business\",\n  \"target_channels\": [\"telegram\"],\n  \"timestamp\": \"2026-08-27T15:30:00Z\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const env = pm.environment.get('env') || 'mock';",
                  "if (env === 'mock') {",
                  "  pm.test('Skipped on mock: invalid token value requires real JWT/Bearer verification middleware', function () {",
                  "    pm.expect(true).to.eql(true);",
                  "  });",
                  "} else {",
                  "  pm.test('Invalid token returns 401 or 403', function () {",
                  "    pm.expect([401, 403]).to.include(pm.response.code);",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
