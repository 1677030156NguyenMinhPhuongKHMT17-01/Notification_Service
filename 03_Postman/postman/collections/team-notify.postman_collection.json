    {
      "name": "05_Consumer_side_Smoke",
      "item": [
        {
          "name": "TC15 - Consumer smoke - Notification queries Alert Detail from Core Business Mock",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{coreBusinessMockUrl}}/alerts/0196fb3d-4ad7-7d1e-9f49-5d5148d2babc",
              "host": ["{{coreBusinessMockUrl}}"],
              "path": ["alerts", "0196fb3d-4ad7-7d1e-9f49-5d5148d2babc"]
            },
            "description": "Consumer-side smoke test: Notification Service gọi sang Core Business Mock Server (core-business.openapi.yaml) để đối chiếu trạng thái alert."
          },
          "response": [],
          "event": [
