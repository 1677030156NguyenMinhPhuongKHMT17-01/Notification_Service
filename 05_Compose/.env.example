# API configuration
APP_HOST=0.0.0.0
APP_PORT=8000
ENV=local
SERVICE_NAME=notification-service
SERVICE_VERSION=0.5.0
IMAGE_TAG=v0.1.0-team-notify
AUTH_TOKEN=local-dev-token

# PostgreSQL configuration (internal Compose host: db)
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=lab05
POSTGRES_PASSWORD=lab05pass
POSTGRES_DB=notificationdb

# Pair 04 – Core Business -> Notification MQTT Broker (internal Compose host: mqtt-broker)
MQTT_ENABLED=true
MQTT_PORT=1883
MQTT_BROKER_URL=mqtt://mqtt-broker:1883
MQTT_TOPIC=campus.alerts
MQTT_DLQ_TOPIC=campus.alerts.dlq
MQTT_CLIENT_ID=notification-service-g7
MQTT_WORKER_THREADS=4

# Delivery policy
MAX_RETRIES=3
RETRY_INTERVAL_SECONDS=5
FAIL_CHANNELS=

# Optional real channel adapters (leave empty for safe stdout mock mode)
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WEBHOOK_TIMEOUT_SECONDS=5

