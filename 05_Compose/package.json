{
  "name": "fit4110-lab05-notification-compose",
  "version": "0.5.0",
  "description": "FIT4110 Lab 05 - Docker Compose readiness and end-to-end verification for Notification Service (Group 7)",
  "private": true,
  "scripts": {
    "mock:notify": "prism mock contracts/notification.openapi.yaml --host 0.0.0.0 --port 4010",
    "lint:openapi": "spectral lint contracts/*.yaml --fail-severity error",
    "test:compose": "newman run postman/collections/FIT4110_lab05_notification_compose.postman_collection.json -e postman/environments/FIT4110_lab05_local.postman_environment.json -r cli,junit,htmlextra --reporter-junit-export reports/newman-lab05-compose.xml --reporter-htmlextra-export reports/newman-lab05-compose.html"
  },
  "devDependencies": {
    "@stoplight/prism-cli": "^5.14.2",
    "@stoplight/spectral-cli": "^6.11.1",
    "newman": "^6.2.1",
    "newman-reporter-htmlextra": "^1.23.1",
    "wait-on": "^7.2.0"
  }
}

