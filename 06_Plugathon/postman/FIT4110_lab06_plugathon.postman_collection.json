        {
          "name": "TC02 - POST /notifications (alert.created) - happy path saves notificationId",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/notifications",
              "host": ["{{baseUrl}}"],
              "path": ["notifications"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"{{evCreated}}\",\n  \"event_name\": \"alert.created\",\n  \"correlationId\": \"req-plugathon-happy-01\",\n  \"source\": \"core-business\",\n  \"alert_id\": \"{{happyAlertId}}\",\n  \"severity\": \"high\",\n  \"message\": \"Phát hiện sự cố an ninh khẩn cấp từ Core Business (Plug-a-thon)\",\n  \"target_channels\": [\"telegram\", \"email\", \"sms\"],\n  \"timestamp\": \"{{tsCreated}}\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const now = Date.now();",
                  "pm.collectionVariables.set('evCreated', pm.variables.replaceIn('{{$guid}}'));",
                  "pm.collectionVariables.set('happyAlertId', 'ALT-' + (6000 + Math.floor(Math.random() * 2999)));",
                  "pm.collectionVariables.set('tsCreated', new Date(now - 20000).toISOString());",
                  "pm.collectionVariables.set('tsEscalated', new Date(now - 10000).toISOString());",
                  "pm.collectionVariables.set('tsResolved', new Date(now).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('NotificationLog created and delivered', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('notification_id');",
                  "  pm.expect(json).to.have.property('event_id', pm.collectionVariables.get('evCreated'));",
                  "  pm.expect(json).to.have.property('alert_id', pm.collectionVariables.get('happyAlertId'));",
                  "  pm.expect(json).to.have.property('sent', true);",
                  "  pm.expect(json).to.have.property('status', 'delivered');",
                  "  pm.collectionVariables.set('notificationId', json.notification_id);",
                  "});"
                ]
              }
            }
          ]
        },
