# FIT4110 Lab 06 Plug-a-thon – Notification Service (Nhóm 7)
# Safe local/mock defaults only. Never commit real credentials, tokens, or `.env`.

# API configuration
APP_HOST=0.0.0.0
APP_PORT=8000
ENV=plugathon
SERVICE_NAME=notification-service
SERVICE_VERSION=1.0.0
IMAGE_TAG=v1.0.0-plugathon
AUTH_TOKEN=plugathon-dev-token

# PostgreSQL configuration (internal Compose host: db)
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=plugathon
POSTGRES_PASSWORD=plugathon-local-pass
POSTGRES_DB=notificationdb

# Pair 04 – Core Business -> Notification MQTT Broker
# Standalone stack uses local Mosquitto container (`mqtt://mqtt-broker:1883`).
# External Plug-a-thon overlay overrides via `MQTT_BROKER_URL` (e.g. `mqtt://192.168.1.51:1883`).
MQTT_ENABLED=true
MQTT_PORT=1883
MQTT_BROKER_URL=mqtt://mqtt-broker:1883
MQTT_TOPIC=campus.alerts
MQTT_DLQ_TOPIC=campus.alerts.dlq
MQTT_CLIENT_ID=notification-service-g7
MQTT_WORKER_THREADS=4

# Delivery & Fault-Tolerance policy (Pair 04 contract: max 3 retries, 5s interval)
MAX_RETRIES=3
RETRY_INTERVAL_SECONDS=5
FAIL_CHANNELS=

# Optional real channel adapters (leave empty for safe stdout mock mode)
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WEBHOOK_TIMEOUT_SECONDS=5
