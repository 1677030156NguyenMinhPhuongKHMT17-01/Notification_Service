# Copy to .env for local overrides. Never commit real tokens.
APP_HOST=0.0.0.0
APP_PORT=8000
SERVICE_NAME=notification-service
SERVICE_VERSION=0.4.0
ENV=local

# Dev-only bearer token used by Postman environment "FIT4110_lab04_local"
AUTH_TOKEN=local-dev-token

# Pair 04 – Core Business -> Notification (async MQTT)
# Keep false for standalone Lab 04; set true on the class network (Lab 05/06)
MQTT_ENABLED=false
MQTT_BROKER_URL=mqtt://192.168.1.51:1883
MQTT_TOPIC=campus.alerts
MQTT_DLQ_TOPIC=campus.alerts.dlq
MQTT_CLIENT_ID=notification-service-g6

# Delivery policy (event-contract-04: max 3 retries, 5 s apart)
MAX_RETRIES=3
RETRY_INTERVAL_SECONDS=5

# Demo only: comma-separated channels that always fail (e.g. sms) to show retry -> DLQ
FAIL_CHANNELS=

# Real channel credentials are NOT used in Lab 04 (mock senders only).
# TELEGRAM_BOT_TOKEN=
# SMTP_PASSWORD=

