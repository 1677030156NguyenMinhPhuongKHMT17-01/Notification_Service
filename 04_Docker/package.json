{
  "name": "fit4110-lab04-notification-docker",
  "version": "0.4.0",
  "description": "FIT4110 Lab 04 - Docker packaging and Newman verification for Notification Service (Group 7)",
  "private": true,
  "scripts": {
    "mock:notify": "prism mock contracts/notification.openapi.yaml --host 0.0.0.0 --port 4010",
    "lint:openapi": "spectral lint contracts/*.yaml --fail-severity error",
    "test:mock": "newman run postman/collections/FIT4110_lab04_notification_docker.postman_collection.json -e postman/environments/FIT4110_lab04_mock.postman_environment.json -r cli,junit,htmlextra --reporter-junit-export reports/newman-lab04-mock.xml --reporter-htmlextra-export reports/newman-lab04-mock.html",
    "test:local": "newman run postman/collections/FIT4110_lab04_notification_docker.postman_collection.json -e postman/environments/FIT4110_lab04_local.postman_environment.json -r cli,junit,htmlextra --reporter-junit-export reports/newman-lab04-local.xml --reporter-htmlextra-export reports/newman-lab04-local.html"
  },
  "devDependencies": {
    "@stoplight/prism-cli": "^5.14.2",
    "@stoplight/spectral-cli": "^6.11.1",
    "newman": "^6.2.1",
    "newman-reporter-htmlextra": "^1.23.1",
    "wait-on": "^7.2.0"
  }
}

